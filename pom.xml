<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>es.uji.security</groupId>
  <version>2.2.0-SNAPSHOT</version>
  <artifactId>CryptoApplet</artifactId>
  <packaging>pom</packaging>
  <name>CryptoApplet</name>
  <url>https://github.com/universitatjaumei/cryptoapplet</url>

  <organization>
    <name>Universitat Jaume I</name>
    <url>http://www.uji.es/</url>
  </organization>

  <modules>
    <module>uji-config</module>
    <module>uji-utils</module>
    <module>uji-crypto-core</module>
    <module>uji-crypto-raw</module>
    <module>uji-crypto-cms</module>
    <module>uji-crypto-xmldsign</module>
    <module>uji-crypto-openxades</module>
    <module>uji-crypto-jxades</module>
    <module>uji-crypto-mityc</module>
    <module>uji-format-pdf</module>
    <module>uji-format-pades</module>
    <module>uji-format-odf</module>
    <module>uji-format-facturae</module>
    <module>uji-keystore</module>
  </modules>

  <licenses>
    <license>
      <name>GPL-v3.0</name>
      <url>http://www.gnu.org/licenses/gpl-3.0.txt</url>
    </license>
    <license>
      <name>EUPL-v1.2</name>
      <url>https://interoperable-europe.ec.europa.eu/licence/european-union-public-licence-version-12-eupl</url>
    </license>
  </licenses>

  <issueManagement>
    <system>CryptoApplet Github</system>
    <url>https://github.com/universitatjaumei/cryptoapplet</url>
  </issueManagement>

  <developers>
    <developer>
      <name>Ricardo Borillo</name>
      <email>borillo@uji.es</email>
      <roles>
        <role>commiter</role>
      </roles>
    </developer>
    <developer>
      <name>Paul Santapau</name>
      <email>santapau@uji.es</email>
      <roles>
        <role>commiter</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:universitatjaumei/cryptoapplet.git</connection>
    <url>https://github.com/universitatjaumei/cryptoapplet</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>nexus</id>
      <url>https://nexus3.uji.es/content/repositories/releases</url>
    </repository>
    <snapshotRepository>
      <id>nexus</id>
      <url>https://nexus3.uji.es/content/repositories/snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <uji.keystore.file>${uji.keytool.keystore}</uji.keystore.file>
            <uji.keystore.type>${uji.keytool.keystoreType}</uji.keystore.type>
            <uji.keystore.password>${uji.keytool.password}</uji.keystore.password>
            <uji.keystore.keypassword>${uji.keytool.password}</uji.keystore.keypassword>
            <uji.keystore.alias>${uji.keytool.alias}</uji.keystore.alias>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>default</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <uji.keytool.keystore>../uji.keystore</uji.keytool.keystore>
        <uji.keytool.keystoreType>JKS</uji.keytool.keystoreType>
        <uji.keytool.alias>uji</uji.keytool.alias>
        <uji.keytool.password>cryptoapplet</uji.keytool.password>
      </properties>
    </profile>
  </profiles>
</project>
